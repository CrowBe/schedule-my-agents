# Local development only. Production values must be configured in Sites.
SITE_ORIGIN=https://schedule-my-agents.bennycrow91.chatgpt.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Do not set until production provider ingress has been verified.
GOOGLE_WEBHOOK_VERIFIED=false
# Separate alarm encryption/transport keys; encryption key is never sent to Cloudflare.
DISPATCHER_ORIGIN=
ALARM_ENCRYPTION_KEY=
ALARM_REGISTRATION_KEY=
ALARM_CALLBACK_KEY=
# Advertise the event catalog only after migrated hosted delivery is verified.
MCP_EVENTS_READY=false
