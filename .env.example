# Exact HTTPS origin of your self-hosted bridge (no trailing path).
SITE_ORIGIN=https://calendar.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Enable only after verifying unauthenticated provider webhook ingress.
GOOGLE_WEBHOOK_VERIFIED=false
# Opaque alarm dispatcher configuration. ALARM_ENCRYPTION_KEY stays on the bridge only.
DISPATCHER_ORIGIN=
ALARM_ENCRYPTION_KEY=
ALARM_REGISTRATION_KEY=
ALARM_CALLBACK_KEY=
# Enable event catalog discovery after migrations and transport checks pass.
MCP_EVENTS_READY=false

# --- Self-hosted single-user authentication ---
# Stable owner identity for this single-user bridge (default: owner).
OWNER_ID=owner
# Setup/admin secret for the sign-in form and `Authorization: Bearer` admin scripts.
# Generate with `openssl rand -base64 32`. Unset means /api/* fails closed with 401.
ADMIN_SECRET=
# Bearer token your MCP Events agent host sends to POST /mcp. Must differ from ADMIN_SECRET;
# it never authorizes /api/* setup routes. Unset means /mcp fails closed with 401.
MCP_AUTH_TOKEN=
# Optional key material for signing the 24-hour admin session cookie.
# Defaults to TOKEN_ENCRYPTION_KEY, then ADMIN_SECRET. Rotating it signs out all sessions.
SESSION_SECRET=
# Set to true ONLY behind a reverse proxy that strips caller-supplied x-authenticated-owner
# and sets it itself. Used for /api/* when ADMIN_SECRET is unset, and /mcp when MCP_AUTH_TOKEN is unset.
TRUST_PROXY_AUTH_HEADER=false

# --- Optional calendar write-back ---
# Request the narrower Google write scope for opt-in agent RSVP and run-status notes.
# Write-back stays off per calendar until you enable it in setup.
GOOGLE_WRITE_SCOPE_ENABLED=false
